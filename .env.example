# ==============================================
# Environment Variables Template (.env.example)
# ==============================================

# Backend Laravel API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/

# Filament Admin Panel URL
NEXT_PUBLIC_ADMIN_PANEL_URL=http://127.0.0.1:8000/admin

# Pusher / Realtime Broadcasting Keys
NEXT_PUBLIC_PUSHER_APP_KEY=your_pusher_app_key_here
NEXT_PUBLIC_PUSHER_APP_CLUSTER=ap2
